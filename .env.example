# ==============================================================================
# SnapLink Enterprise Environment Variables
# Single source of configuration for Local, Staging, and Production deployments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Production MongoDB connection string with connection pooling parameters
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/snaplink?retryWrites=true&w=majority&maxPoolSize=10

# ------------------------------------------------------------------------------
# 2. Application Base URLs
# ------------------------------------------------------------------------------
# The canonical domain of your application (used for OG previews, redirects, and canonical links)
NEXT_PUBLIC_BASE_URL=https://snaplink.to
NEXT_PUBLIC_APP_NAME=SnapLink

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens (Access & Refresh tokens)
# Generate a secure 64-char key: openssl rand -base64 48
JWT_SECRET=your_super_secret_production_jwt_key_replace_in_production
JWT_REFRESH_SECRET=your_super_secret_production_jwt_refresh_key_replace_in_production

# Optional: Google OAuth 2.0 Client ID for 1-Tap Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 4. White-Label Custom Domains & CNAME Target
# ------------------------------------------------------------------------------
# The primary CNAME target that custom branded domains point to in their DNS
NEXT_PUBLIC_CNAME_TARGET=cname.snaplink.to

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Bot Defense
# ------------------------------------------------------------------------------
# Maximum requests per minute for public link creation
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
